<dialog
    title="RML Demo"
    width="420">
    <div class="login">
        <h1>{t("login.title")}</h1>
        <p>{t("login.hint")}</p>
        <div class="login-form">
            <input value={username} placeholder={t("login.username")} />
            <Button label={t("login.submit")} primary on-click={on_login} />
        </div>
    </div>
</dialog>
