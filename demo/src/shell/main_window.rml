<tab-window
    title="RML Showcase"
    width="1100"
    height="720"
    startup="CenterScreen"
    icon="logo.svg"
    tabs={tab_items}
    selected-index={selected_tab}
    on-tab-click="on_tab_click"
    on-tab-close="on_tab_close"
    on-tab-close-all="on_tab_close_all"
    on-tab-close-others="on_tab_close_others"
    show-chrome={show_chrome}
    left-size={slot_left_size}>

    <template slot="left">
        <ActivityBar ref="activity_bar" />
    </template>

    <template slot="menu">
        <menu-bar>
            <menu-item
                each={m in menus}
                label={m.label()}
                children={m.children}
                command={m.command()} />
        </menu-bar>
    </template>

    <template slot="bottom" scope={panel}>
        <div class="flex flex-col size-full">
            <div class="flex flex-row items-center justify-between px-3 py-1.5 border-b">
                <div class="text-[13px] font-semibold">终端面板</div>
                <div class="flex gap-3 text-xs text-muted-foreground">
                    <span>slot={panel.slot_name()}</span>
                    <span>size={panel.current_size().map(|s| format!("{}", s)).unwrap_or("N/A".to_string())}</span>
                    <span>resizable={panel.has_resizable()}</span>
                </div>
            </div>
            <div class="flex-1 px-3 py-2 text-xs text-muted-foreground">
                <span>$ demo terminal — scope variable accessible from slot content</span>
            </div>
        </div>
    </template>

    <template slot="footer">
        <native-status-bar>
            <div class="flex gap-2">
                <component each={s in status_left} content={s.render(_window, cx)} />
            </div>
            <div class="flex gap-2">
                <component each={s in status_center} content={s.render(_window, cx)} />
            </div>
            <div class="flex gap-2">
                <component each={s in status_right} content={s.render(_window, cx)} />
            </div>
        </native-status-bar>
    </template>

</tab-window>
