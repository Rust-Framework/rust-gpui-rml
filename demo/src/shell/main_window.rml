<tab-window
    title="RML Showcase"
    width="1100"
    height="720"
    startup="CenterScreen"
    icon="logo.svg"
    selected-index={selected_tab}
    on-tab-click="on_tab_click"
    on-tab-close="on_tab_close"
    on-tab-close-all="on_tab_close_all"
    on-tab-close-others="on_tab_close_others"
    show-chrome={show_chrome}
    on-chrome-toggle="on_chrome_toggle"
    left-size={slot_left_size}>

    <template slot="tabs" each={w in workbenches}>
        <Tab label={w.name()} closable />
    </template>

    <template slot="left">
        <ActivityBar ref="activity_bar" />
    </template>

    <template slot="menu">
        <component content={self.render_menu_bar(_window, cx)} />
    </template>

    <template slot="bottom" scope={panel}>
        <component content={self.render_bottom_panel(panel, _window, cx)} />
    </template>

    <template slot="footer">
        <component content={self.render_status_bar(_window, cx)} />
    </template>

    <component content={self.active_view(_window, cx)} />

</tab-window>
