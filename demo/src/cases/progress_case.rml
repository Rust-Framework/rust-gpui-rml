<component>
    <div v-flex="" class="case-pane doc-pane">
        <h2>{t("case.progress.title")}</h2>

        <Card title="组件说明">
            <p>Progress 是 RML 的进度条组件。通过 value 属性设置进度值（0-100），loading 属性切换加载中状态。</p>
        </Card>

        <Card title="基础用法">
            <p>value 属性设置进度百分比，{status_text}</p>
            <div v-flex="" gap-2="">
                <Progress value={current} />
            </div>
        </Card>

        <Card title="交互演示">
            <p>通过命令修改 current 字段，实时反映到 value 绑定；切换 loading 状态用 if 条件渲染不同 Progress。</p>
            <div h-flex="" gap-4="">
                <Button label="减少 10" on-click={on_decrease} />
                <Button label="增加 10" on-click={on_increase} />
                <Button label="切换 loading" on-click={on_toggle_loading} />
            </div>
            <div v-flex="" gap-2="">
                <Progress value={current} if={!loading} />
                <Progress loading="" if={loading} />
            </div>
        </Card>

        <Card title="加载中状态">
            <p>loading 属性显示加载动画。</p>
            <div v-flex="" gap-2="">
                <Progress loading="" />
            </div>
        </Card>

        <Card title="API">
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </Card>
    </div>
</component>
