<component>
    <CaseDocPage
        title={t("case.ref.title")}
        description="ref 指令通过 ref 属性声明元素引用名，关联到 ViewModel 中的同名字段。首次渲染后可在 command 回调中命令式访问（focus、set_value、scroll 等）。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <div class="demo-section">
                <h3>基础用法</h3>
                <p>下方 Input 通过 ref="input_state" 绑定到 ViewModel 同名字段：</p>
                <Input ref="input_state" />
                <p>注：首次渲染完成前引用尚未就绪；在 command 回调中可调用 focus、set_value 等方法。</p>
            </div>
        </template>

        <template slot="api">
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </template>
    </CaseDocPage>
</component>
