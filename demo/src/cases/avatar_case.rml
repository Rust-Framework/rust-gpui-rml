<component>
    <div v-flex="" class="case-pane doc-pane">
        <h2>{t("case.avatar.title")}</h2>
        <p>Avatar 是 RML 的头像组件，标签为 PascalCase <code>Avatar</code>。支持三种内容模式 + 四种尺寸 + 容器包裹。优先级：src &gt; name &gt; placeholder。</p>

        <Card title="内容模式">
            <h3>src 图片源</h3>
            <p>src 属性指定图片 URL，加载失败自动回退到 name 或 placeholder。</p>
            <div h-flex="" gap-4="">
                <Avatar src="https://avatars.githubusercontent.com/u/5518?v=4" size="large" />
                <Avatar src="https://avatars.githubusercontent.com/u/28998859?v=4" />
                <Avatar src="https://avatars.githubusercontent.com/u/20092316?v=4" size="small" />
            </div>

            <h3>name 首字母</h3>
            <p>name 属性提取首字母显示（如 "Jason Lee" → "JL"）。</p>
            <div h-flex="" gap-4="">
                <Avatar name="Jason Lee" size="large" />
                <Avatar name="Floyd Wang" />
                <Avatar name="Alice" size="small" />
            </div>

            <h3>placeholder 占位图标</h3>
            <p>无 src/name 时显示 IconName 图标。值为 IconName 枚举名（PascalCase）。</p>
            <div h-flex="" gap-4="">
                <Avatar size="large" placeholder="CircleUser" />
                <Avatar placeholder="Building2" />
                <Avatar size="small" placeholder="Bell" />
            </div>
        </Card>

        <Card title="尺寸 size">
            <p>size 属性控制头像大小：xsmall / small / medium / large。</p>
            <div h-flex="" gap-4="">
                <Avatar name="XS" size="xsmall" />
                <Avatar name="S" size="small" />
                <Avatar name="M" size="medium" />
                <Avatar name="L" size="large" />
            </div>
        </Card>

        <Card title="动态绑定(model + computed + if)">
            <p>输入姓名，点击按钮循环切换尺寸，观察头像实时变化：</p>
            <input model={name} placeholder="输入姓名" />
            <p>当前姓名：{name} | 当前尺寸：{size_label}</p>
            <div h-flex="" gap-4="">
                <div if={size_index % 3 == 0}>
                    <Avatar name={name} size="small" />
                </div>
                <div if={size_index % 3 == 1}>
                    <Avatar name={name} size="medium" />
                </div>
                <div if={size_index % 3 == 2}>
                    <Avatar name={name} size="large" />
                </div>
            </div>
            <Button label="切换尺寸" primary="" on-click={on_cycle_size} />
        </Card>

        <Card title="头像分组 AvatarGroup">
            <p>AvatarGroup 容器组合多个 Avatar，支持 limit 限制 + ellipsis 折叠。详见 <code>avatar_group_case</code>。</p>
            <AvatarGroup limit="3" ellipsis="">
                <Avatar src="https://avatars.githubusercontent.com/u/5518?v=4" />
                <Avatar src="https://avatars.githubusercontent.com/u/28998859?v=4" />
                <Avatar src="https://avatars.githubusercontent.com/u/20092316?v=4" />
                <Avatar src="https://avatars.githubusercontent.com/u/22312482?v=4" />
                <Avatar name="John Doe" />
            </AvatarGroup>
        </Card>

        <Card title="示例代码">
            <p>点击下方 Tab 切换 <code>.rml</code> 声明文件与 <code>.rml.rs</code> 后端文件：</p>
            <TabBar selected-index={code_tab} on-click={on_code_tab_change}>
                <Tab label=".rml">
                    <CodeEditor ref="rml_editor" value={rml_sample} language="rml" />
                </Tab>
                <Tab label=".rml.rs">
                    <CodeEditor ref="rust_editor" value={rust_sample} language="rust" />
                </Tab>
            </TabBar>
        </Card>

        <Card title="API">
            <h3>Avatar</h3>
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
            <p>另：AvatarGroup 的 limit/ellipsis 属性详见 <code>avatar_group_case</code>。</p>
        </Card>
    </div>
</component>
