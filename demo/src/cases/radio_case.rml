<component>
    <CaseDocPage
        title={t("case.radio.title")}
        description="Radio 和 RadioGroup 是 RML 的单选组件，标签为 PascalCase Radio / RadioGroup（或 kebab-case radio-group）。RadioGroup 构造器为 vertical(id)/horizontal(id)（new 私有），RadioGroup 的 on-click 事件签名为 Fn(&amp;usize, ...)（选中索引）。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <div class="demo-section">
                <h3>RadioGroup 基础（垂直）</h3>
                <p>默认垂直布局，<code>selected-index</code> 设置选中索引，<code>on-click</code> 处理选中切换：</p>
                <RadioGroup selected-index={selected_index} on-click={on_select}>
                    <Radio label="选项 1" />
                    <Radio label="选项 2" />
                    <Radio label="选项 3" />
                </RadioGroup>
                <p>当前选中索引：{selected_index}</p>
            </div>

            <div class="demo-section">
                <h3>RadioGroup 水平布局</h3>
                <p><code>layout="horizontal"</code> 切换为水平布局：</p>
                <RadioGroup layout="horizontal" selected-index={selected_index} on-click={on_select}>
                    <Radio label="A" />
                    <Radio label="B" />
                    <Radio label="C" />
                    <Radio label="D" />
                </RadioGroup>
            </div>

            <div class="demo-section">
                <h3>layout 属性</h3>
                <p><code>layout="horizontal"</code> 与默认 <code>layout="vertical"</code> 的对比：</p>
                <RadioGroup layout="horizontal" selected-index={selected_index} on-click={on_select}>
                    <Radio label="X" />
                    <Radio label="Y" />
                    <Radio label="Z" />
                </RadioGroup>
            </div>

            <div class="demo-section">
                <h3>静态 selected-index</h3>
                <p>使用静态数值属性（无绑定，不会自动更新）：</p>
                <RadioGroup selected-index="1">
                    <Radio label="选项 A" />
                    <Radio label="选项 B" />
                    <Radio label="选项 C" />
                </RadioGroup>
            </div>

            <div class="demo-section">
                <h3>Radio tab-index / tab-stop</h3>
                <p><code>tab-index</code> 设置 Tab 顺序，<code>tab-stop</code> 控制是否参与 Tab 导航：</p>
                <RadioGroup selected-index={selected_index} on-click={on_select}>
                    <Radio label="tab-index=0" tab-index="0" />
                    <Radio label="tab-index=1" tab-index="1" />
                    <Radio label="tab-stop=false" tab-stop="false" tab-index="2" />
                </RadioGroup>
            </div>

            <div class="demo-section">
                <h3>文本子节点作为 Radio</h3>
                <p>RadioGroup 的子节点支持纯文本（自动转换为 Radio，<code>From&lt;&amp;str&gt; for Radio</code>）：</p>
                <RadioGroup selected-index={selected_index} on-click={on_select}>
                    文本选项 1
                    文本选项 2
                    文本选项 3
                </RadioGroup>
            </div>
        </template>

        <template slot="api">
            <h3>Radio</h3>
            <Table columns={api_columns} rows={radio_rows} bordered="" stripe="" />

            <h3>RadioGroup</h3>
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
            <p>另：RadioGroup 的 <code>on-click</code> 事件签名为 <code>Fn(&amp;usize, ...)</code>（选中索引），不是 ClickEvent。</p>
        </template>
    </CaseDocPage>
</component>
