<component>
    <CaseDocPage
        title={t("case.counter.title")}
        description="计数器案例演示 RML 的命令绑定与状态更新。通过 #[command] 方法处理点击事件，修改 pub 字段后框架自动触发重渲。核心概念：pub 字段是 observable，#[computed] 方法缓存计算结果，#[command] 方法处理事件并更新字段。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <Card title="基础计数">
                <p>{counter_text}</p>
                <div class="button-row">
                    <Button label="点击 +1" variant="primary" on-click={on_click} />
                    <Button label="重置" variant="ghost" on-click={on_reset} />
                </div>
            </Card>
            <Card title="步长控制">
                <p>当前步长：{step}（每次点击 +步长）</p>
                <div class="button-row">
                    <Button label="步长 +1" on-click={on_inc_step} />
                </div>
            </Card>
        </template>
        <template slot="api">
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </template>
    </CaseDocPage>
</component>
