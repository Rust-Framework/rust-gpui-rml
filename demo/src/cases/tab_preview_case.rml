<component>
    <CaseDocPage
        title={t("case.tab_preview.title")}
        description="VSCode 风格的 tab 体验：关闭按钮 tooltip（i18n）、右键菜单（Close/Close All/Close Others）、预览模式（italic 标题）、双击 promote。框架内置三个标准菜单项，文本走 i18n（rml.tab.close / rml.tab.close_all / rml.tab.close_others）。业务通过 on-close / on-close-all / on-close-others 回调驱动数据层变更。双击 tab 触发 on-promote 回调（250ms 时间窗口）。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <Card title="演示效果">
                <p>{status_text}</p>

                <div class="demo-section">
                    <div display="flex" flex-direction="row" gap="8px">
                        <Button label="重置" on-click={on_reset} />
                    </div>
                    <p>提示：右键 tab 弹出菜单；双击 preview tab（斜体标题）触发 promote；hover 关闭按钮显示 tooltip。</p>
                    <Tabs
                        selected-index={selected_index}
                        on-click={on_tab_select}
                        on-close={on_tab_close}
                        on-close-all={on_tab_close_all}
                        on-close-others={on_tab_close_others}
                        on-promote={on_tab_promote}>
                        <Tab each={tab in tabs}
                            label={tab.title}
                            closable={tab.closable}
                            preview={tab.preview} />
                    </Tabs>
                </div>
            </Card>
        </template>

        <template slot="api">
            <h3>Tabs / Tab</h3>
            <h3>Tabs</h3>
            <Table columns={tabs_api_columns} rows={tabs_api_rows} bordered="" stripe="" />
            <h3>Tab</h3>
            <Table columns={tab_api_columns} rows={tab_api_rows} bordered="" stripe="" />
        </template>
    </CaseDocPage>
</component>
