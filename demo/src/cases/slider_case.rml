<component>
    <CaseDocPage
        title={t("case.slider.title")}
        description="Slider 是 RML 的滑块组件。通过 ref 引用滑块实例，用 min/max/step/default-value 配置范围与初始值，支持单值与双拇指范围模式。on-change 在值变化时触发回调。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <div class="demo-section">
                <h3>基础用法</h3>
                <p><code>min="0" max="100" step="1" default-value="50"</code> 配置数值范围与初始值。</p>
                <div display="flex" flex-direction="column" gap="8px">
                    <Slider ref="slider_state" min="0" max="100" step="1" default-value="50" />
                </div>
            </div>

            <div class="demo-section">
                <h3>禁用状态 disabled</h3>
                <p><code>disabled={true}</code> 禁止拖动与键盘操作。</p>
                <div display="flex" flex-direction="column" gap="8px">
                    <Slider ref="disabled_state" min="0" max="100" default-value="30" disabled={true} />
                </div>
            </div>

            <div class="demo-section">
                <h3>范围 Range</h3>
                <p>将 <code>default-value</code> 绑定为元组（如 20~80）启用双拇指范围滑块，<code>step="5"</code> 控制步长。</p>
                <div display="flex" flex-direction="column" gap="8px">
                    <Slider ref="range_state" min="0" max="100" step="5" default-value={range_default} />
                </div>
            </div>
        </template>
        <template slot="api">
            <h3>Slider</h3>
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
            <p>min/max/step/default-value 在 RML 中直接声明即可，无需在 Rust 侧手动初始化。</p>
        </template>
    </CaseDocPage>
</component>