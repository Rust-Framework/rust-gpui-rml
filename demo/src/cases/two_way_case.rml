<component>
    <div class="case-pane">
        <h2 class="case-title">{t("case.two_way.title")}</h2>
        <div class="form">
            <input model={name} placeholder={t("demo.name_placeholder")} />
            <input model={age} placeholder={t("demo.age_placeholder")} />
            <p class="profile">{profile_summary}</p>
        </div>
    </div>
</component>
