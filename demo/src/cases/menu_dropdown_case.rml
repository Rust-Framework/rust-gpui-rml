<component>
    <div v_flex="" class="case-pane">
        <h2>{t("case.menu.dropdown.title")}</h2>
        <p>{dropdown_status}</p>
        <dropdown-menu anchor="TopRight">
            <Button label="Options" ghost="" />
            <menu-item label="Custom Action" icon="Star" onclick={on_custom} />
            <menu-separator />
            <menu-item label="Standard Action" onclick={on_standard} />
            <menu-separator />
            <menu-item label="Exit" onclick={on_exit} />
        </dropdown-menu>
    </div>
</component>
