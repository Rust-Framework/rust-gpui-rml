<component>
    <div v-flex="" class="case-pane doc-pane">
        <h2>{t("case.menu.dropdown.title")}</h2>

        <Card title="组件说明">
            <p>Dropdown Menu 是 gpui-component 下拉菜单的 RML 封装，标签为 dropdown-menu。第一个子元素作为触发器，点击触发弹出菜单。</p>
            <p>核心概念：第一个子节点（通常是 Button）作为触发器；anchor 控制弹出位置（TopRight/BottomLeft 等）；menu-item 定义菜单项；menu-separator 分组分隔。</p>
        </Card>

        <Card title="API">
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </Card>

        <Card title="示例代码">
            <CodeEditor value={code_sample} />
        </Card>

        <Card title="演示效果">
            <p>{dropdown_status}</p>

            <div class="demo-section">
                <h3>基础下拉</h3>
                <p>anchor="TopRight" 锚定右上角弹出，点击 Button 触发：</p>
                <dropdown-menu anchor="TopRight">
                    <Button label="Options" ghost="" />
                    <menu-item label="Custom Action" icon="Star" on-click={on_custom} />
                    <menu-separator />
                    <menu-item label="Standard Action" on-click={on_standard} />
                    <menu-separator />
                    <menu-item label="Exit" on-click={on_exit} />
                </dropdown-menu>
            </div>

            <div class="demo-section">
                <h3>分隔符与图标</h3>
                <p>menu-separator 分组，icon 添加图标，观察菜单项视觉分组：</p>
                <dropdown-menu anchor="TopRight">
                    <Button label="带图标的菜单" ghost="" />
                    <menu-item label="Custom Action" icon="Star" on-click={on_custom} />
                    <menu-separator />
                    <menu-item label="Standard Action" icon="Check" on-click={on_standard} />
                    <menu-separator />
                    <menu-item label="Exit" icon="Close" on-click={on_exit} />
                </dropdown-menu>
            </div>
        </Card>
    </div>
</component>
