<component>
    <CaseDocPage
        title={t("case.color_picker.title")}
        description="ColorPicker 颜色选择器，支持 label、icon、size 等属性。通过 ref 绑定到 ViewModel 同名字段，on-change 事件在颜色变化时触发。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <div class="demo-section">
                <h3>1. 基础用法 + on-change 事件</h3>
                <p>ColorPicker 通过 ref 绑定到 ViewModel 同名字段。选择颜色后触发 on-change 事件。</p>
                <p>当前颜色：{current_color}</p>
                <ColorPicker ref="basic_picker" on-change={on_color_change} />
            </div>

            <div class="demo-section">
                <h3>2. label 属性</h3>
                <p>label 设置标签文本，走通用 static setter 映射到 .label()。</p>
                <ColorPicker ref="labeled_picker" label="主题色" />
            </div>

            <div class="demo-section">
                <h3>3. icon 属性</h3>
                <p>icon 设置图标名称（如 Value）。</p>
                <ColorPicker ref="icon_picker" icon="Palette" />
            </div>

            <div class="demo-section">
                <h3>4. 尺寸 size</h3>
                <p>size 属性设置尺寸：xsmall / small / medium / large。点击按钮循环切换尺寸。</p>
                <p>当前尺寸：{size_label}</p>
                <div class="button-row">
                    <Button label="切换尺寸" on-click={on_cycle_size} />
                    <ColorPicker ref="sized_picker" size={size_value} />
                </div>
            </div>

            <div class="demo-section">
                <h3>API</h3>
                <Table columns={api_columns} rows={api_rows} bordered />
            </div>
        </template>
    </CaseDocPage>
</component>
