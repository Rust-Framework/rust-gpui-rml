<component>
    <CaseDocPage
        title={t("case.key.title")}
        description="key 指令为 each 列表项提供稳定 ElementId。编译器生成 .id((&quot;rml_key&quot;, rml_core::element_id::from_key(&expr)))，使 GPUI 在列表重排时能正确识别移动项，保留元素状态（焦点、动画、内部 state）。key 表达式在 each 作用域内求值，直接引用循环变量（如 item.id）。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <Card title="带 key 的列表">
                <p>共 {item_count} 项，每项含 id 和 label：</p>
                <div display="flex" flex-direction="row" gap="16px">
                    <Button label="头部插入" on-click={on_prepend} />
                    <Button label="清空" on-click={on_clear} />
                </div>
                <div display="flex" flex-direction="row" gap="8px" flex-wrap="wrap">
                    <div each={item in items} key={item.id} padding="8px 4px">
                        <Tag>{item.id}</Tag>
                        <Tag>{item.label}</Tag>
                    </div>
                </div>
                <p>注：key=&#123;item.id&#125; 确保头部插入新项时，已有项的 ElementId 保持稳定，避免状态丢失。</p>
            </Card>
        </template>

        <template slot="api">
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </template>
    </CaseDocPage>
</component>
