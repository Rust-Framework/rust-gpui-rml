<component>
    <CaseDocPage
        title={t("case.conditional.title")}
        description="条件渲染案例演示 RML 的 if/else-if/else 指令。if={expr} 在条件为真时渲染元素，else-if={expr} 实现多分支条件链，else 提供默认分支。支持互斥条件渲染。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <Card title="Tab 切换（if/else-if 链）">
                <p>当前 Tab：{tab_label}</p>
                <div display="flex" flex-direction="row" gap="16px">
                    <Button label="概览" on-click={on_tab_overview} />
                    <Button label="详情" on-click={on_tab_detail} />
                    <Button label="设置" on-click={on_tab_settings} />
                </div>
                <div display="flex" flex-direction="column" gap="8px">
                    <Card title="概览内容" if={tab_index == 0}>
                        <p>这是概览页面，展示项目基本信息。</p>
                    </Card>
                    <Card title="详情内容" else-if={tab_index == 1}>
                        <p>这是详情页面，展示项目的详细数据。</p>
                    </Card>
                    <Card title="设置内容" else-if={tab_index == 2}>
                        <p>这是设置页面，配置项目选项。</p>
                    </Card>
                </div>
            </Card>

            <Card title="布尔切换（if + if 取反）">
                <p>show_detail = {show_detail}</p>
                <div display="flex" flex-direction="row" gap="16px">
                    <Button label="切换显示" on-click={on_toggle_detail} />
                </div>
                <div display="flex" flex-direction="column" gap="8px">
                    <Card title="详情已显示" if={show_detail}>
                        <p>show_detail 为 true 时渲染此卡片。</p>
                    </Card>
                    <Card title="详情已隐藏" if={!show_detail}>
                        <p>show_detail 为 false 时渲染此卡片。</p>
                    </Card>
                </div>
            </Card>
        </template>

        <template slot="api">
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </template>
    </CaseDocPage>
</component>
