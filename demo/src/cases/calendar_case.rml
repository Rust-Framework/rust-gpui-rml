<component>
    <CaseDocPage
        title={t("case.calendar.title")}
        description="Calendar 日历选择器，支持 size 尺寸属性。通过 ref 绑定到 ViewModel 同名字段，on-select 事件在选择日期时触发。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <div class="demo-section">
                <h3>1. 基础用法 + on-select 事件</h3>
                <p>Calendar 通过 ref 绑定到 ViewModel 同名字段。选择日期后触发 on-select 事件。</p>
                <p>选中日期：{selected_date}</p>
                <Calendar ref="basic_calendar" on-select={on_date_select} />
            </div>

            <div class="demo-section">
                <h3>2. 尺寸 size</h3>
                <p>size 属性设置尺寸：xsmall / small / medium / large。点击按钮循环切换尺寸。</p>
                <p>当前尺寸：{size_label}</p>
                <div class="button-row">
                    <Button label="切换尺寸" on-click={on_cycle_size} />
                </div>
                <Calendar ref="sized_calendar" size={size_value} />
            </div>

            <div class="demo-section">
                <h3>API</h3>
                <Table columns={api_columns} rows={api_rows} bordered />
            </div>
        </template>
    </CaseDocPage>
</component>
