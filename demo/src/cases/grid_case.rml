<component>
    <CaseDocPage
        title={t("case.grid.title")}
        description="Grid 是 CSS Grid 布局容器。通过 columns/rows 定义等宽列与等高行，GridItem 支持 col-span/row-span 跨格。适合表单栅格、仪表盘面板、IDE 布局等场景。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <div class="demo-section">
                <h3>基础 Grid 布局</h3>
                <p>3 列等宽网格，子元素自动填充。</p>
                <Grid columns="3" gap="12px">
                    <div style="background: var(--surface-variant); padding: 16px; text-align: center; border-radius: 4px;">1</div>
                    <div style="background: var(--surface-variant); padding: 16px; text-align: center; border-radius: 4px;">2</div>
                    <div style="background: var(--surface-variant); padding: 16px; text-align: center; border-radius: 4px;">3</div>
                    <div style="background: var(--surface-variant); padding: 16px; text-align: center; border-radius: 4px;">4</div>
                    <div style="background: var(--surface-variant); padding: 16px; text-align: center; border-radius: 4px;">5</div>
                    <div style="background: var(--surface-variant); padding: 16px; text-align: center; border-radius: 4px;">6</div>
                </Grid>
            </div>

            <div class="demo-section">
                <h3>col-span 跨列</h3>
                <p>3 列网格中，部分单元格跨 2 列。</p>
                <Grid columns="3" gap="12px">
                    <GridItem col-span="2">
                        <div style="background: var(--accent); padding: 16px; text-align: center; border-radius: 4px; color: var(--primary);">跨 2 列</div>
                    </GridItem>
                    <div style="background: var(--surface-variant); padding: 16px; text-align: center; border-radius: 4px;">1 列</div>
                    <div style="background: var(--surface-variant); padding: 16px; text-align: center; border-radius: 4px;">1 列</div>
                    <GridItem col-span="2">
                        <div style="background: var(--accent); padding: 16px; text-align: center; border-radius: 4px; color: var(--primary);">跨 2 列</div>
                    </GridItem>
                </Grid>
            </div>

            <div class="demo-section">
                <h3>IDE 风格布局</h3>
                <p>模拟 IDE 面板：3 列 x 3 行 + col-span/row-span 组合，编辑器区跨 2 列 2 行。</p>
                <Grid columns="3" rows="3" gap="4px" style="height: 300px;">
                    <GridItem col-span="3">
                        <div style="background: var(--title-bar); padding: 8px 12px; border-radius: 4px; font-size: 13px;">顶部 Menu Bar</div>
                    </GridItem>
                    <div style="background: var(--surface-variant); padding: 12px; border-radius: 4px; font-size: 13px; overflow: hidden;">
                        侧边栏 / 文件树
                    </div>
                    <GridItem col-span="2" row-span="2">
                        <div style="background: var(--accent); padding: 12px; border-radius: 4px; font-size: 13px; color: var(--primary); height: 100%; overflow: hidden;">
                            主编辑区 Editor Area（跨 2 列 2 行）
                        </div>
                    </GridItem>
                    <div style="background: var(--surface-variant); padding: 12px; border-radius: 4px; font-size: 13px; overflow: hidden;">
                        工具 / Outline
                    </div>
                    <GridItem col-span="3">
                        <div style="background: var(--status-bar); padding: 8px 12px; border-radius: 4px; font-size: 13px;">底部 Status Bar</div>
                    </GridItem>
                </Grid>
            </div>

            <div class="demo-section">
                <h3>表单栅格布局</h3>
                <p>2 列表单，备注字段跨整行。</p>
                <Grid columns="2" gap="12px">
                    <div>
                        <p style="margin-bottom: 4px; font-size: 13px;">姓名</p>
                        <Input ref="field1_input" placeholder="请输入姓名" />
                    </div>
                    <div>
                        <p style="margin-bottom: 4px; font-size: 13px;">邮箱</p>
                        <Input ref="field2_input" placeholder="请输入邮箱" />
                    </div>
                    <GridItem col-span="2">
                        <p style="margin-bottom: 4px; font-size: 13px;">备注（跨 2 列）</p>
                        <Input ref="remark_input" placeholder="请输入备注" />
                    </GridItem>
                </Grid>
            </div>
        </template>

        <template slot="api">
            <h3>Grid / GridItem 属性</h3>
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </template>
    </CaseDocPage>
</component>