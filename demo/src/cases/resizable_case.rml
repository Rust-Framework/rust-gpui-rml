<component>
    <CaseDocPage
        title={t("case.resizable.title")}
        description="Resizable 是可调整面板组组件，标签为 PascalCase Resizable 或 kebab-case resizable。direction 属性选择水平/垂直方向。子节点 resizable-panel 支持样式属性和子节点。非 panel 子节点自动包裹为 panel。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <div class="demo-section">
                <h3>水平可调整面板（拖拽分隔条调整宽度）</h3>
                <p>三个面板，前两个设置初始宽度，最后一个自适应：</p>
                <resizable direction="horizontal" height="200px">
                    <resizable-panel size="200px" style="background: var(--surface); padding: 12px;">
                        <p font-bold="">面板 1</p>
                        <p>初始宽度 200px，可拖拽右侧分隔条调整</p>
                    </resizable-panel>
                    <resizable-panel size="300px" style="background: var(--surface-variant); padding: 12px;">
                        <p font-bold="">面板 2</p>
                        <p>初始宽度 300px</p>
                    </resizable-panel>
                    <resizable-panel style="background: var(--surface); padding: 12px;">
                        <p font-bold="">面板 3</p>
                        <p>自适应宽度（flex_grow: 1）</p>
                    </resizable-panel>
                </resizable>
            </div>

            <div class="demo-section">
                <h3>垂直可调整面板（拖拽分隔条调整高度）</h3>
                <p>使用 direction="vertical" 切换 v_resizable 构造器：</p>
                <resizable direction="vertical" height="300px">
                    <resizable-panel size="100px" style="background: var(--surface); padding: 12px;">
                        <p font-bold="">顶部面板</p>
                        <p>初始高度 100px</p>
                    </resizable-panel>
                    <resizable-panel style="background: var(--surface-variant); padding: 12px;">
                        <p font-bold="">中间面板</p>
                        <p>自适应高度</p>
                    </resizable-panel>
                    <resizable-panel size="80px" style="background: var(--surface); padding: 12px;">
                        <p font-bold="">底部面板</p>
                        <p>初始高度 80px</p>
                    </resizable-panel>
                </resizable>
            </div>

            <div class="demo-section">
                <h3>非 Panel 子节点自动包裹</h3>
                <p>直接放置 div 等元素，自动包裹为 panel：</p>
                <resizable direction="horizontal" height="120px">
                    <div style="background: var(--surface); padding: 12px; flex: 1;">
                        <p font-bold="">自动包裹 1</p>
                        <p>div 直接作为子节点</p>
                    </div>
                    <div style="background: var(--surface-variant); padding: 12px; flex: 1;">
                        <p font-bold="">自动包裹 2</p>
                        <p>div 直接作为子节点</p>
                    </div>
                </resizable>
            </div>
        </template>

        <template slot="api">
            <h3>Resizable</h3>
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
            <p>注：direction 为静态属性（选择 h/v 方向），size 支持静态和绑定两种形式（如 size="400px" 或 size=&#123;height&#125;）。ResizablePanelGroup 不支持样式属性，CSS 样式仅作用于 resizable-panel 子节点。resizable-panel 支持子节点及所有样式属性，另有 size/size_range/visible 属性。</p>
        </template>
    </CaseDocPage>
</component>
