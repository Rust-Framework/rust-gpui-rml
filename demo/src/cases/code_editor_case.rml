<component>
    <CaseDocPage
        title={t("case.code_editor.title")}
        description="CodeEditor 多行代码编辑器，内置语法高亮（30+ 语言）、代码折叠、行号、缩进辅助与搜索。支持 language、value、ref 等属性，推荐配合 rml-code-editor 样式类与 height 定制外观。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <div class="demo-section">
                <h3>Rust 语法高亮</h3>
                <p>language="rust" 语法高亮，支持关键字/字符串/注释等着色。</p>
                <CodeEditor class="rml-code-editor" ref="rust_editor" height="320px" />
            </div>

            <div class="demo-section">
                <h3>JSON 语法高亮</h3>
                <p>language="json"，支持键名/字符串/数字/布尔值/null 着色。</p>
                <CodeEditor class="rml-code-editor" ref="json_editor" height="280px" />
            </div>

            <div class="demo-section">
                <h3>Python 语法高亮</h3>
                <p>language="python"，支持关键字/装饰器/字符串/类型注解等着色。</p>
                <CodeEditor class="rml-code-editor" ref="python_editor" height="340px" />
            </div>

            <div class="demo-section">
                <h3>JavaScript 语法高亮</h3>
                <p>language="javascript"，支持 class/箭头函数/模板字符串等着色。</p>
                <CodeEditor class="rml-code-editor" ref="js_editor" height="340px" />
            </div>
        </template>

        <template slot="api">
            <h3>CodeEditor</h3>
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
            <p>注：支持 rust、javascript、typescript、python、go、java、json、css、html、sql 等 30+ 语言。slot 模板内使用 value 绑定需配合 ref 预创建编辑器实例。</p>
        </template>
    </CaseDocPage>
</component>
