<component>
    <CaseDocPage
        title={t("case.code_editor.title")}
        description="CodeEditor 是基于 InputState 的代码编辑器组件，自动应用 mono 字体 + size_full。通过 ref 指令引用 InputState，在 on_loaded 中通过 .code_editor(language).multi_line(true) 配置。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <Card title="基础用法">
                <p>默认 Rust 代码高亮，支持多行编辑。code_editor 方法设置语言，multi_line 启用多行模式。</p>
                <CodeEditor ref="editor_state" />
            </Card>
        </template>

        <template slot="api">
            <h3>CodeEditor</h3>
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </template>
    </CaseDocPage>
</component>
