<component>
    <CaseDocPage
        title={t("case.menu.editor.title")}
        description="Editor Menu 案例演示 dropdown-menu 的 check-side 属性与勾选状态绑定。check-side=&quot;Right&quot; 将勾选标记显示在菜单项右侧，适用于编辑器类菜单场景。核心概念：check-side 控制勾选标记位置；menu-item checked=&#123;bool&#125; 绑定布尔字段实现勾选状态同步；菜单项分组通过 menu-separator 实现；命令回调更新 last_action 状态。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <Card title="演示效果">
                <p>{editor_status}</p>

                <div class="demo-section">
                    <h3>编辑器菜单基础</h3>
                    <p>check-side="Right" 勾选标记在右侧，点击 Edit 触发菜单：</p>
                    <dropdown-menu check-side="Right">
                        <Button label="Edit" variant="ghost" />
                        <menu-item label="Save" on-click={on_save} />
                        <menu-item label="Save As" on-click={on_save_as} />
                        <menu-separator />
                        <menu-item label="Find" on-click={on_find} />
                        <menu-item label="Replace" on-click={on_replace} />
                    </dropdown-menu>
                </div>

                <div class="demo-section">
                    <h3>勾选状态</h3>
                    <p>checked={word_wrap} 绑定字段，点击 Word Wrap 切换状态，观察勾选标记：</p>
                    <dropdown-menu check-side="Right">
                        <Button label="View" variant="ghost" />
                        <menu-item label="Word Wrap" checked={word_wrap} on-click={on_toggle_wrap} />
                    </dropdown-menu>
                </div>

                <div class="demo-section">
                    <h3>分隔符与命令分组</h3>
                    <p>Save/Save As 一组，Find/Replace 一组，观察视觉分组：</p>
                    <dropdown-menu check-side="Right">
                        <Button label="File" variant="ghost" />
                        <menu-item label="Save" icon="Check" on-click={on_save} />
                        <menu-item label="Save As" icon="File" on-click={on_save_as} />
                        <menu-separator />
                        <menu-item label="Find" icon="Search" on-click={on_find} />
                        <menu-item label="Replace" icon="Replace" on-click={on_replace} />
                        <menu-separator />
                        <menu-item label="Word Wrap" checked={word_wrap} on-click={on_toggle_wrap} />
                    </dropdown-menu>
                </div>
            </Card>
        </template>

        <template slot="api">
            <h3>Menu Editor</h3>
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </template>
    </CaseDocPage>
</component>
