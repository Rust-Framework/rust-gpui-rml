<component>
    <CaseDocPage
        title={t("case.card.title")}
        description="Card 是 RML 的卡片容器组件。通过 title/extra/cover/footer 组合内容，支持 bordered/borderless/hoverable 样式控制。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <Card title="基础用法">
                <p><code>title</code> 属性设置卡片标题，子节点为卡片内容。</p>
                <Card title="基础卡片">
                    <p>这是卡片的内容区域，可以放置任意元素。</p>
                </Card>
            </Card>

            <Card title="无边框模式 borderless">
                <p><code>borderless=""</code> 移除边框。</p>
                <Card title="无边框卡片" borderless="">
                    <p>无边框卡片，适合嵌入其他容器。</p>
                </Card>
            </Card>

            <Card title="悬浮效果 hoverable">
                <p><code>hoverable=""</code> 启用鼠标悬浮交互效果。</p>
                <Card title="可悬浮卡片" hoverable="">
                    <p>鼠标悬浮时卡片会有视觉反馈。</p>
                </Card>
            </Card>

            <Card title="动态绑定(value 双向绑定 + hoverable 切换)">
                <p>输入标题和内容，点击按钮切换 hoverable，观察 Card 实时变化（演示 value 双向绑定）：</p>
                <input value={card_title} placeholder="输入卡片标题" />
                <input value={card_body} placeholder="输入卡片内容" />
                <p>当前 hoverable: {hoverable}</p>
                <div class="button-row">
                    <Button label="切换 hoverable" primary on-click={on_toggle_hoverable} />
                </div>
                <Card title={card_title} hoverable={hoverable}>
                    <p>{card_body}</p>
                </Card>
            </Card>
        </template>

        <template slot="api">
            <h3>Card</h3>
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </template>
    </CaseDocPage>
</component>
