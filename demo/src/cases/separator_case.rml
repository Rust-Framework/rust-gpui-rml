<component>
    <CaseDocPage
        title={t("case.separator.title")}
        description="Separator 是 RML 的分隔符组件，标签为 PascalCase Separator。无 new() 构造器，通过 horizontal()/vertical()/dashed() 关联函数构造。RML 中用 vertical/dashed 属性切换方向和样式。常用于区分不同内容区块或侧边栏分隔。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <div class="demo-section">
                <h3>水平分隔符（默认）</h3>
                <p>默认水平方向分隔符，常用于垂直布局中区分上下内容区块。</p>
                <div display="flex" flex-direction="column" gap="8px">
                    <p>上方内容</p>
                    <Separator />
                    <p>下方内容</p>
                </div>
            </div>

            <div class="demo-section">
                <h3>垂直分隔符 vertical</h3>
                <p>vertical 属性切换为垂直方向。需配合 display=flex flex-direction=row 容器使用，常用于水平布局中分隔左右内容。</p>
                <div display="flex" flex-direction="row" gap="16px" align-items="center">
                    <p>左侧</p>
                    <Separator vertical="" />
                    <p>右侧</p>
                </div>
            </div>

            <div class="demo-section">
                <h3>虚线样式 dashed</h3>
                <p>dashed 属性使用虚线样式，常用于柔和的视觉分隔。</p>
                <div display="flex" flex-direction="column" gap="8px">
                    <p>上方内容</p>
                    <Separator dashed="" />
                    <p>下方内容</p>
                </div>
            </div>

            <div class="demo-section">
                <h3>组合样式 vertical + dashed</h3>
                <p>垂直 + 虚线组合，常用于侧边栏分隔。</p>
                <div display="flex" flex-direction="row" gap="16px" align-items="center">
                    <p>左侧</p>
                    <Separator vertical="" dashed="" />
                    <p>右侧</p>
                </div>
            </div>

            <div class="demo-section">
                <h3>动态切换（if 条件渲染）</h3>
                <p>点击按钮切换方向和样式，观察下方分隔符变化（演示 if 条件渲染 + 绑定）。</p>
                <p>当前方向: {orientation_label} | 虚线: {dashed_label}</p>
                <div class="button-row">
                    <Button label="切换方向" on-click={on_toggle_orientation} />
                    <Button label="切换虚线" primary on-click={on_toggle_dashed} />
                </div>
                <div if={is_vertical} display="flex" flex-direction="row" gap="16px" align-items="center">
                    <p>左侧</p>
                    <Separator vertical={is_vertical} dashed={is_dashed} />
                    <p>右侧</p>
                </div>
                <div if={!is_vertical} display="flex" flex-direction="column" gap="8px">
                    <p>上方内容</p>
                    <Separator vertical={is_vertical} dashed={is_dashed} />
                    <p>下方内容</p>
                </div>
            </div>
        </template>

        <template slot="api">
            <h3>Separator</h3>
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </template>
    </CaseDocPage>
</component>
