<component>
    <CaseDocPage
        title={t("case.animation.title")}
        description="animate 指令为元素添加入场动画。基于 GPUI AnimationExt 实现，支持 fade / slide-up / slide-down / slide-left 四种预设。语法：animate=&#123;fade&#125; 或 animate=&#123;fade:500&#125;（冒号后指定毫秒时长）。与 if 组合可重播动画（元素重新挂载时触发）；与 show 组合时 show 降级为 if 语义（AnimationElement 不实现 Styled，invisible 不可用）。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <div class="demo-section">
                <h3>animate 指令演示</h3>
                <p>visible = {visible}（点击切换以重播动画）</p>
                <div display="flex" flex-direction="row" gap="16px">
                    <Button label="切换可见性" on-click={on_toggle_visible} />
                </div>

                <div display="flex" flex-direction="column" gap="12px">
                    <div if={visible} animate="fade"
                        style="padding: 16px; background: var(--surface-variant); border-radius: 8px; color: var(--foreground);">
                        fade — 淡入（opacity 0→1，300ms）
                    </div>
                    <div if={visible} animate="slide-up"
                        style="padding: 16px; background: var(--surface); border-radius: 8px; color: var(--foreground);">
                        slide-up — 从下滑入（top + opacity，300ms）
                    </div>
                    <div if={visible} animate="slide-down"
                        style="padding: 16px; background: var(--accent); border-radius: 8px; color: var(--accent-foreground);">
                        slide-down — 从上滑入（top + opacity，300ms）
                    </div>
                    <div if={visible} animate="slide-left"
                        style="padding: 16px; background: var(--secondary); border-radius: 8px; color: var(--secondary-foreground);">
                        slide-left — 从右滑入（left + opacity，300ms）
                    </div>
                    <div if={visible} animate="fade:600"
                        style="padding: 16px; background: var(--primary); border-radius: 8px; color: var(--primary-foreground);">
                        fade:600 — 自定义时长 600ms
                    </div>
                </div>
            </div>

            <div class="demo-section">
                <h3>animate + show 组合</h3>
                <p>show_card = {show_card}（show 降级为 if 语义）</p>
                <div display="flex" flex-direction="row" gap="16px">
                    <Button label="切换 show" on-click={on_toggle_show} />
                </div>
                <div display="flex" flex-direction="column" gap="12px">
                    <div show={show_card} animate="slide-up"
                        style="padding: 16px; background: var(--surface-variant); border-radius: 8px; color: var(--foreground);">
                        show + slide-up — show 降级为条件渲染（不占布局空间）
                    </div>
                </div>
            </div>
        </template>

        <template slot="api">
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </template>
    </CaseDocPage>
</component>
