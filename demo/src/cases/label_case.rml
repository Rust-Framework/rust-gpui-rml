<component>
    <CaseDocPage
        title={t("case.label.title")}
        description="Label 是 RML 的文本标签组件，标签为 PascalCase Label。构造器接受 label 文本作为参数（非 ElementId），通过 label 属性或文本子节点设置。继承 Styled trait，支持 text_color / text_size / font_weight / text_align 等样式属性，适合表单标签、说明文字、通用文本展示。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <div class="demo-section">
                <h3>基础用法</h3>
                <p>通过 label 属性设置标签文本。</p>
                <div display="flex" flex-direction="column" gap="8px">
                    <Label label="用户名" />
                    <Label label="邮箱地址" />
                    <Label label="密码" />
                </div>
            </div>

            <div class="demo-section">
                <h3>文本子节点</h3>
                <p>也可以通过文本子节点设置标签内容，等价于 label 属性。</p>
                <Label>通过子节点设置的标签</Label>
            </div>

            <div class="demo-section">
                <h3>样式定制</h3>
                <p>Label 继承 Styled trait，支持 text_color / text_size / font_weight / text_align 等样式属性。</p>
                <div display="flex" flex-direction="column" gap="8px">
                    <Label label="大标题" text-size="xl" font-bold="" />
                    <Label label="中标题" text-size="lg" font-semibold="" />
                    <Label label="说明文字" text-size="sm" text-color="--text-muted" />
                    <Label label="居中对齐" text-center="" />
                </div>
            </div>

            <div class="demo-section">
                <h3>动态绑定（字段绑定）</h3>
                <p>点击按钮切换 text 字段，下方 Label 实时更新（演示字段绑定到文本子节点）。</p>
                <div class="button-row">
                    <Button label="切换文本" on-click={on_cycle_text} />
                </div>
                <p>当前文本: {text}</p>
                <Label>{text}</Label>
            </div>
        </template>

        <template slot="api">
            <h3>Label</h3>
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
            <p>另：text_color / text_size / font_weight / text_align 等样式属性来自 Styled trait。</p>
        </template>
    </CaseDocPage>
</component>
