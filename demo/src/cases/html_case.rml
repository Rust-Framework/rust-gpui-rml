<component>
    <CaseDocPage
        title={t("case.html.title")}
        description="html 指令渲染 HTML 字符串。GPUI 无原生 HTML 渲染能力，html=&#123;raw&#125; 降级为文本节点，HTML 标签作为字面量文本显示。支持与 if/show/each 组合。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <div class="demo-section">
                <h3>基础用法</h3>
                <p>html_content 字段值：</p>
                <div html={html_content.clone()} />
                <p>注：实际渲染为 Label 文本节点，HTML 标签作为字面量字符显示（未被解析为样式）。</p>
            </div>
        </template>

        <template slot="api">
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </template>
    </CaseDocPage>
</component>
