<component>
    <div v-flex="" class="case-pane doc-pane">
        <h2>{t("case.progress_circle.title")}</h2>

        <Card title="组件说明">
            <p>ProgressCircle 是 gpui-component 圆形进度组件的 RML 封装。通过 value 属性设置进度值（0-100）。</p>
        </Card>

        <Card title="基础用法">
            <p>value 属性设置圆形进度百分比。</p>
            <div h-flex="" gap-4="">
                <ProgressCircle value={current} />
            </div>
        </Card>

        <Card title="加载中状态">
            <p>loading 属性显示循环加载动画。</p>
            <div h-flex="" gap-4="">
                <ProgressCircle loading="" />
            </div>
        </Card>

        <Card title="API">
            <div class="api-table">
                <div class="api-row api-header"><span class="api-prop-name">属性</span><span class="api-prop-type">类型</span><span>说明</span></div>
                <div class="api-row"><span class="api-prop-name">value</span><span class="api-prop-type">f32</span><span>进度值 0-100</span></div>
                <div class="api-row"><span class="api-prop-name">loading</span><span class="api-prop-type">布尔标志</span><span>加载中状态</span></div>
                <div class="api-row"><span class="api-prop-name">size</span><span class="api-prop-type">small/medium/large</span><span>尺寸</span></div>
            </div>
        </Card>
    </div>
</component>
