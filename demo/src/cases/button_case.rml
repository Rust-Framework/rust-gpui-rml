<component>
    <CaseDocPage
        title={t("case.button.title")}
        description="Button 是 RML 的按钮组件，标签为 PascalCase Button。支持 9 种 variant、4 种尺寸、disabled/selected/loading 状态、compact 紧凑模式、tooltip 悬浮提示等能力。小写 button 属于内置 HTML 轨，映射为 gpui::div()，不是本组件。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <div class="demo-section">
                <h3>变体 variants</h3>
                <p>9 种 variant 通过 variant 属性切换（variant="primary" / "secondary" / "danger" / "success" / "warning" / "info" / "ghost" / "link" / "text"）。不写 variant 即默认 Secondary。</p>
                <div class="button-row">
                    <Button label="Default" on-click={on_basic_click} />
                    <Button label="Primary" variant="primary" on-click={on_basic_click} />
                    <Button label="Secondary" variant="secondary" on-click={on_basic_click} />
                    <Button label="Danger" variant="danger" on-click={on_basic_click} />
                    <Button label="Success" variant="success" on-click={on_basic_click} />
                    <Button label="Warning" variant="warning" on-click={on_basic_click} />
                    <Button label="Info" variant="info" on-click={on_basic_click} />
                    <Button label="Ghost" variant="ghost" on-click={on_basic_click} />
                    <Button label="Link" variant="link" on-click={on_basic_click} />
                    <Button label="Text" variant="text" on-click={on_basic_click} />
                </div>
                <p>累计点击次数：{basic_clicks}</p>
            </div>

            <div class="demo-section">
                <h3>尺寸 size</h3>
                <p>size 属性控制按钮大小：xsmall / small / medium / large。</p>
                <div class="button-row">
                    <Button label="XSmall" size="xsmall" variant="primary" />
                    <Button label="Small" size="small" variant="primary" />
                    <Button label="Medium" size="medium" variant="primary" />
                    <Button label="Large" size="large" variant="primary" />
                </div>
                <p class="hint">注：在 gpui-component 底层实现中，Size::Large 与 Size::Medium 走同一高度分支（h_8 + px_4 + text_base），视觉等价。建议优先使用 XSmall/Small/Medium 三档以体现尺寸差异。</p>
            </div>

            <div class="demo-section">
                <h3>disabled 禁用</h3>
                <p>disabled 属性禁用按钮交互，点击切换查看效果。当前：{disabled_status_text}</p>
                <div class="button-row">
                    <Button label="切换禁用" on-click={on_toggle_disabled} />
                    <Button label="Disabled Button" disabled={is_disabled} variant="primary" />
                </div>
            </div>

            <div class="demo-section">
                <h3>selected 选中</h3>
                <p>selected 属性切换按钮选中态，点击切换查看效果。当前：{selected_status_text}</p>
                <div class="button-row">
                    <Button label="切换选中" on-click={on_toggle_selected} />
                    <Button label="Selected Button" selected={is_selected} />
                </div>
            </div>

            <div class="demo-section">
                <h3>loading 加载中</h3>
                <p>loading 属性显示加载指示器，点击切换查看效果。当前：{loading_status_text}</p>
                <div class="button-row">
                    <Button label="切换 Loading" on-click={on_toggle_loading} />
                    <Button label="Loading Button" loading={is_loading} variant="primary" />
                </div>
            </div>

            <div class="demo-section">
                <h3>紧凑模式 compact</h3>
                <p>compact 属性减少按钮内边距，常用于工具栏或密集表单。</p>
                <div class="button-row">
                    <Button label="Normal" variant="primary" />
                    <Button label="Compact" variant="primary" compact="" />
                </div>
            </div>

            <div class="demo-section">
                <h3>tooltip 悬浮提示</h3>
                <p>tooltip 属性添加鼠标悬浮提示文本，常用于图标按钮或操作说明。</p>
                <div class="button-row">
                    <Button label="Save" variant="primary" tooltip="保存当前文档 (Ctrl+S)" />
                    <Button label="Delete" variant="danger" tooltip="删除后不可恢复" />
                </div>
            </div>

            <div class="demo-section">
                <h3>字体权重 font weight</h3>
                <p>font_bold / font_semibold / font_medium 等属性切换字体权重（StyledExt trait）。</p>
                <div class="button-row">
                    <Button label="Normal" variant="primary" />
                    <Button label="Bold" variant="primary" font-bold="" />
                    <Button label="Semibold" variant="primary" font-semibold="" />
                    <Button label="Medium" variant="primary" font-medium="" />
                </div>
            </div>

            <div class="demo-section">
                <h3>按钮组 ButtonGroup</h3>
                <p>ButtonGroup 容器组合多个按钮，常用于操作分组。支持 size 属性统一子按钮尺寸。</p>
                <div class="button-row">
                    <ButtonGroup>
                        <Button label="上一页" />
                        <Button label="下一页" />
                    </ButtonGroup>
                    <ButtonGroup size="small">
                        <Button label="A" />
                        <Button label="B" />
                        <Button label="C" />
                    </ButtonGroup>
                </div>
                <p>详见 button_group_case 案例。</p>
            </div>
        </template>

        <template slot="api">
            <h3>Button</h3>
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
            <p>另：tooltip 属性为字符串，映射到 .tooltip(text)。</p>
            <p>另：font_bold / font_semibold / font_medium / font_light 等字体权重属性来自 StyledExt trait。</p>
        </template>
    </CaseDocPage>
</component>
