<component>
    <CaseDocPage
        title={t("case.title_bar.title")}
        description="TitleBar 是 RML 的窗口标题栏组件。无 ElementId 构造（StatelessNoId），容器模式。自动渲染窗口控制按钮（最小化/最大化/关闭），子节点渲染在中央区域。通常用于 modern-window 的标题栏组合。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <div class="demo-section">
                <h3>基础用法</h3>
                <p>包裹子元素作为标题栏中央内容。窗口控制按钮自动渲染。</p>
                <div style="border: 1px solid var(--border); overflow: hidden; border-radius: 4px;">
                    <TitleBar>
                        <span>RML Showcase</span>
                    </TitleBar>
                </div>
            </div>

            <div class="demo-section">
                <h3>动态绑定(value 双向绑定)</h3>
                <p>输入标题文本,观察 TitleBar 中央内容实时更新(演示 value 双向绑定):</p>
                <input value={title} placeholder="输入标题文本" />
                <p>当前标题: {title}</p>
                <div class="button-row">
                    <Button label="重置标题" on-click={on_reset_title} />
                </div>
                <div style="border: 1px solid var(--border); overflow: hidden; border-radius: 4px;">
                    <TitleBar>
                        <span>{title}</span>
                    </TitleBar>
                </div>
            </div>
        </template>
        <template slot="api">
            <h3>TitleBar</h3>
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </template>
    </CaseDocPage>
</component>
