<component>
    <CaseDocPage
        title={t("case.collapsible.title")}
        description="Collapsible 是 RML 的折叠容器组件，标签为 PascalCase Collapsible。无 ElementId 构造（RenderOnce），实现 ParentElement。open 属性控制展开/折叠状态，content 内容仅在 open=true 时显示。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <div class="demo-section">
                <h3>基础用法</h3>
                <p>通过 <code>open</code> 属性控制内容显示。点击下方按钮切换展开状态：</p>
                <p>当前状态：{state_label}</p>
                <div class="button-row">
                    <Button label="切换展开" primary on-click={on_toggle} />
                </div>
                <Collapsible open={is_open}>
                    <div display="flex" flex-direction="column" gap="8px" class="collapsible-content">
                        <p>这是折叠内容。当 open=true 时显示。</p>
                        <p>可以包含任意子元素。</p>
                    </div>
                </Collapsible>
            </div>

            <div class="demo-section">
                <h3>静态 open</h3>
                <p><code>open="true"</code> 静态属性设置默认展开：</p>
                <Collapsible open="true">
                    <div display="flex" flex-direction="column" gap="8px">
                        <p>这个内容默认展开显示。</p>
                    </div>
                </Collapsible>
                <p><code>open="false"</code> 或不写 open 属性则默认折叠：</p>
                <Collapsible>
                    <div display="flex" flex-direction="column" gap="8px">
                        <p>这个内容默认折叠隐藏。</p>
                    </div>
                </Collapsible>
            </div>

            <div class="demo-section">
                <h3>if 条件渲染配合</h3>
                <p>当需要更精细控制时，可使用 <code>if</code> 指令配合 open 状态做条件渲染：</p>
                <Collapsible open={is_open}>
                    <h3>标题（始终显示）</h3>
                    <div if={is_open}>
                        <p>这部分内容使用 if 控制显示，与 open 状态联动。</p>
                    </div>
                </Collapsible>
            </div>

            <div class="demo-section">
                <h3>嵌套折叠</h3>
                <p>Collapsible 可嵌套使用：</p>
                <Collapsible open={is_open}>
                    <div display="flex" flex-direction="column" gap="8px">
                        <p>外层内容</p>
                        <Collapsible open={is_open}>
                            <div display="flex" flex-direction="column" gap="8px">
                                <p>内层内容（与外层联动）</p>
                            </div>
                        </Collapsible>
                    </div>
                </Collapsible>
            </div>
        </template>

        <template slot="api">
            <h3>Collapsible</h3>
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </template>
    </CaseDocPage>
</component>
