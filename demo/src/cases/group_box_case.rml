<component>
    <CaseDocPage
        title={t("case.group_box.title")}
        description="GroupBox 是 RML 的分组容器组件，标签为 PascalCase GroupBox。StatelessNoId 组件（无 ElementId，RenderOnce），实现 ParentElement。提供 title 标题与 3 种 variant（normal/fill/outline），通过独立布尔属性切换。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <div class="demo-section">
                <h3>基础用法 normal</h3>
                <p>默认 normal variant，无边框无背景，仅分组语义。</p>
                <GroupBox title="用户信息">
                    <p>用户名：admin</p>
                    <p>邮箱：admin@example.com</p>
                </GroupBox>
            </div>

            <div class="demo-section">
                <h3>fill 填充背景</h3>
                <p><code>fill</code> 切换为填充背景样式。</p>
                <GroupBox title="设置面板" fill>
                    <p>主题：暗色</p>
                    <p>语言：简体中文</p>
                </GroupBox>
            </div>

            <div class="demo-section">
                <h3>outline 描边</h3>
                <p><code>outline</code> 切换为描边样式。</p>
                <GroupBox title="高级选项" outline>
                    <p>启用通知：是</p>
                    <p>自动更新：否</p>
                </GroupBox>
            </div>

            <div class="demo-section">
                <h3>variant 布尔属性</h3>
                <p>使用 <code>fill</code> / <code>outline</code> / <code>normal</code> 独立布尔属性切换 variant。</p>
                <GroupBox title="示例" fill>
                    <p>通过 fill 布尔属性设置</p>
                </GroupBox>
                <GroupBox title="示例" outline>
                    <p>通过 outline 布尔属性设置</p>
                </GroupBox>
            </div>

            <div class="demo-section">
                <h3>title 动态绑定</h3>
                <p><code>title=&#123;dynamic_title&#125;</code> 绑定动态标题字段：</p>
                <GroupBox title={dynamic_title} fill>
                    <p>当前标题：{dynamic_title}</p>
                    <div class="button-row">
                        <Button label="切换标题" on-click={on_cycle_title} />
                    </div>
                </GroupBox>
            </div>

            <div class="demo-section">
                <h3>无标题</h3>
                <p>不写 <code>title</code> 属性则无标题，仅作为分组容器：</p>
                <GroupBox fill>
                    <p>无标题的分组内容</p>
                </GroupBox>
            </div>
        </template>

        <template slot="api">
            <h3>GroupBox</h3>
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </template>
    </CaseDocPage>
</component>
