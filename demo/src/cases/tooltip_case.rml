<component>
    <div display="flex" flex-direction="column" class="case-pane doc-pane">
        <h2>{t("case.tooltip.title")}</h2>

        <p>Tooltip 在 RML 中作为通用属性使用，而非独立组件。tooltip="text" 生成 .tooltip("text")，由专属 compiler/tooltip 模块处理组件白名单检查（Button / IconButton / DropdownButton / Toggle / Checkbox / Clipboard / Radio / Switch）。</p>

        <Card title="基础用法">
            <p>悬浮按钮查看提示：</p>
            <div display="flex" flex-direction="row" gap="16px">
                <Button label="保存" tooltip="保存文件 (Cmd+S)" />
                <Button label="删除" tooltip="删除选中项" />
                <Button label="撤销" tooltip={dynamic_tooltip} />
            </div>
        </Card>

        <Card title="其他组件">
            <p>Checkbox 和其他支持组件的 tooltip：</p>
            <div display="flex" flex-direction="column" gap="8px">
                <Checkbox tooltip="接受服务条款">同意条款</Checkbox>
                <Switch tooltip="切换深色模式" />
            </div>
        </Card>

        <Card title="代码示例">
            <TabBar selected-index={code_tab} on-click={on_code_tab_change}>
                <Tab label=".rml">
                    <CodeEditor ref="rml_editor" value={rml_sample} language="rml" />
                </Tab>
                <Tab label=".rml.rs">
                    <CodeEditor ref="rust_editor" value={rust_sample} language="rust" />
                </Tab>
            </TabBar>
        </Card>

        <h3>Tooltip</h3>
        <Card title="API">
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </Card>
    </div>
</component>
