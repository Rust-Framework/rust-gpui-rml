<component>
    <div v_flex="" class="case-pane">
        <h2>{t("case.menu.custom.title")}</h2>
        <p>{custom_status}</p>
        <dropdown-menu>
            <Button label="Settings" ghost="" />
            <menu-item header="" label="Display" />
            <menu-item label="Dark Mode" onclick={on_toggle_dark} />
            <menu-separator />
            <menu-item label="Help Center" href="https://longbridge.github.io/gpui-component/" icon="Info" />
            <menu-item label="Sign Out" onclick={on_sign_out} />
        </dropdown-menu>
    </div>
</component>
