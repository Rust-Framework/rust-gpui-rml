<component>
    <CaseDocPage
        title={t("case.native_status_bar.title")}
        description="NativeStatusBar 是 RML 的原生状态栏组件。无 ElementId 构造，容器模式。子节点渲染在中央区域。通常用于 modern-window 的底部状态栏组合。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <Card title="基础用法">
                <p>包裹子元素作为状态栏内容。</p>
                <div style="border: 1px solid #e0e0e0; overflow: hidden; border-radius: 4px;">
                    <NativeStatusBar>
                        <span>就绪</span>
                    </NativeStatusBar>
                </div>
            </Card>

            <Card title="动态状态(#[command] 事件)">
                <p>点击按钮切换状态栏消息(演示 #[command] 事件处理):</p>
                <div class="button-row">
                    <Button label="就绪" primary on-click={on_show_ready} />
                    <Button label="警告" warning on-click={on_show_warning} />
                    <Button label="错误" danger on-click={on_show_error} />
                </div>
                <p>当前状态: {status_text}</p>
                <div style="border: 1px solid #e0e0e0; overflow: hidden; border-radius: 4px;">
                    <NativeStatusBar>
                        <span>{status_text}</span>
                    </NativeStatusBar>
                </div>
            </Card>
        </template>
        <template slot="api">
            <h3>NativeStatusBar</h3>
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </template>
    </CaseDocPage>
</component>
