<component>
    <div v-flex="" class="case-pane doc-pane">
        <h2>{t("case.checkbox.title")}</h2>

        <Card title="组件说明">
            <p>Checkbox 是 gpui-component 复选框组件的 RML 封装。Stateless 组件，通过 checked 属性绑定勾选状态（底层通过 Selectable trait 映射到 .checked()）。</p>
        </Card>

        <Card title="基础用法">
            <p>checked 属性绑定布尔字段，点击按钮切换状态。</p>
            <p>{status_text}</p>
            <div h-flex="" gap-4="">
                <Checkbox label="同意条款" checked={is_checked} />
                <Button label="切换勾选" on-click={on_toggle_checked} />
            </div>
        </Card>

        <Card title="禁用状态">
            <p>disabled 属性禁用复选框交互。</p>
            <div h-flex="" gap-4="">
                <Checkbox label="禁用项" disabled={is_disabled} />
                <Button label="切换禁用" on-click={on_toggle_disabled} />
            </div>
        </Card>

        <Card title="API">
            <div class="api-table">
                <div class="api-row api-header"><span class="api-prop-name">属性</span><span class="api-prop-type">类型</span><span>说明</span></div>
                <div class="api-row"><span class="api-prop-name">label</span><span class="api-prop-type">字符串</span><span>标签文本</span></div>
                <div class="api-row"><span class="api-prop-name">checked</span><span class="api-prop-type">布尔</span><span>勾选状态</span></div>
                <div class="api-row"><span class="api-prop-name">disabled</span><span class="api-prop-type">布尔</span><span>禁用</span></div>
                <div class="api-row"><span class="api-prop-name">size</span><span class="api-prop-type">small/medium/large</span><span>尺寸</span></div>
            </div>
        </Card>
    </div>
</component>
