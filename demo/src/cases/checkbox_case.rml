<component>
    <div v-flex="" class="case-pane doc-pane">
        <h2>{t("case.checkbox.title")}</h2>

        <Card title="组件说明">
            <p>Checkbox 是 gpui-component 复选框组件的 RML 封装。Stateless 组件，通过 checked 属性绑定勾选状态（底层通过 Selectable trait 映射到 .checked()）。</p>
        </Card>

        <Card title="基础用法">
            <p>checked 属性绑定布尔字段，点击按钮切换状态。</p>
            <p>{status_text}</p>
            <div h-flex="" gap-4="">
                <Checkbox label="同意条款" checked={is_checked} on-click={on_toggle_checked} />
                <Button label="切换勾选" on-click={on_toggle_checked_button} />
            </div>
        </Card>

        <Card title="禁用状态">
            <p>disabled 属性禁用复选框交互。</p>
            <div h-flex="" gap-4="">
                <Checkbox label="禁用项" disabled={is_disabled} />
                <Button label="切换禁用" on-click={on_toggle_disabled} />
            </div>
        </Card>

        <Card title="API">
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </Card>
    </div>
</component>
