<component>
    <CaseDocPage
        title={t("case.virtual_tree.title")}
        description="虚拟树演示：Tree 组件内置虚拟化，仅渲染可见节点。本案例生成 10000+ 节点的大型树，验证滚动流畅性。无需额外开关。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <div class="demo-section">
                <h3>10000+ 节点虚拟树</h3>
                <p>总节点数：{total_nodes}（200 根 × 50 叶子）。Tree 自动虚拟化，仅渲染可见行。展开/折叠/滚动均保持流畅。</p>
                <p>当前激活（叶子）：{activated_text}</p>
                <p>当前选中（含文件夹）：{selected_text}</p>
                <div style="height: 480px; border: 1px solid var(--border); overflow: hidden; border-radius: 4px;">
                    <Tree ref="big_tree" items={tree_items} on-activate={on_activate} on-select={on_select} />
                </div>
            </div>
        </template>

        <template slot="api">
            <h3>VirtualTree（内置虚拟化）</h3>
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
            <p>注：Tree 与虚拟树使用相同组件，大型树自动虚拟化，仅渲染可见范围。items 绑定 ViewModel 中的树节点数据。</p>
        </template>
    </CaseDocPage>
</component>
