<component>
    <CaseDocPage
        title={t("case.content_binding.title")}
        description="content 绑定通过 IntoContent trait 统一转换为 child 元素。支持四类输入：IntoElement（String/SharedString/AnyElement）、ToString（i32/bool 等数值）、IVisual（Box&lt;dyn IVisual&gt; trait 对象）、&amp;T 引用（&amp;String/&amp;i32 等，通过 blanket impl Clone 委托）。codegen 对简单字段访问自动添加 &amp; 前缀，无需手写 .clone()。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <Card title="ToString 绑定（i32 / bool）">
                <p>以下 content 绑定 i32 字段 count（当前值：{count}）：</p>
                <div class="content-box" content={self.count} />
                <p>以下 content 绑定 bool 字段 active（当前值：{active}）：</p>
                <div class="content-box" content={self.active} />
                <div class="button-row">
                    <Button label="count +1" primary on-click={on_inc} />
                    <Button label="toggle active" on-click={on_toggle} />
                </div>
            </Card>

            <Card title="IntoElement 绑定（String / SharedString，无需 .clone()）">
                <p>以下 content 绑定 String 字段 message（自动 &amp; 借用）：</p>
                <div class="content-box" content={self.message} />
                <p>以下 content 绑定 SharedString 字段 title（自动 &amp; 借用）：</p>
                <div class="content-box" content={self.title} />
            </Card>

            <Card title="列表循环 + content 绑定（each 指令）">
                <p>以下通过 each 指令遍历 Vec&lt;String&gt;，循环变量 name 为 &amp;String：</p>
                <div class="tag-list">
                    <component each={name in self.names} content={name} />
                </div>
                <p>以下遍历 Vec&lt;Person&gt;，绑定 item.name 字段（自动 &amp; 借用）：</p>
                <div class="tag-list">
                    <component each={person in self.people} content={person.name} />
                </div>
            </Card>

            <Card title="AnyElement 绑定（方法返回值）">
                <p>以下 content 绑定方法 render_badge，返回 AnyElement：</p>
                <div content={self.render_badge(_window, cx)} />
            </Card>

            <Card title="IVisual 绑定（Box<dyn IVisual>）">
                <p>以下 content 绑定方法 make_visual，返回 Box&lt;dyn IVisual&gt;，调用 IVisual::render：</p>
                <div content={self.make_visual()} />
            </Card>
        </template>

        <template slot="api">
            <h3>content 绑定支持的类型</h3>
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </template>
    </CaseDocPage>
</component>
