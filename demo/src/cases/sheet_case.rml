<component>
    <CaseDocPage
        title={t("case.sheet.title")}
        description="Sheet 是 RML 的侧边抽屉组件，标签为 PascalCase Sheet 或小写 sheet（均合法）。从窗口边缘滑入的浮层面板，构造器需要 render 上下文的 _window 和 cx 变量（与标准组件不同）。支持 title/footer 属性、size 尺寸控制、resizable/overlay/overlay_closable 交互控制、on_close 关闭事件。子节点作为 content 通过 .child() 注入。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <div class="demo-section">
                <h3>基础用法</h3>
                <p>Sheet 包裹若干子节点作为 content。设置 title 属性显示标题栏，默认从右侧滑入，直接渲染为覆盖层。</p>
                <Sheet title="基础抽屉">
                    <div class="sheet-content">
                        <p>这是抽屉内容区域。</p>
                        <p>可以放置任意 GPUI 元素。</p>
                    </div>
                </Sheet>
            </div>

            <div class="demo-section">
                <h3>尺寸控制 size</h3>
                <p>size 属性控制抽屉面板的宽度（右侧滑入时），支持 px 和百分比单位。下方演示 size=500px 和 size=50% 的效果对比。</p>
                <div class="sheet-row">
                    <Sheet title="500px 宽度" size="500px">
                        <div class="sheet-tip">宽度 500px 的抽屉面板</div>
                    </Sheet>
                    <Sheet title="50% 宽度" size="50%">
                        <div class="sheet-tip">宽度为窗口 50% 的抽屉面板</div>
                    </Sheet>
                </div>
            </div>

            <div class="demo-section">
                <h3>页脚 footer</h3>
                <p>footer 属性设置抽屉底部页脚内容，适用于放置操作按钮的区域。注意：footer 作为属性接受字符串，如需复杂布局请在子节点中实现。</p>
                <Sheet title="带页脚的抽屉" footer="底部操作栏">
                    <div class="sheet-tip">此抽屉带有 footer 页脚区域</div>
                </Sheet>
            </div>

            <div class="demo-section">
                <h3>交互控制</h3>
                <p>resizable=false 禁用拖拽调整大小，overlay=false 关闭背景遮罩，overlay-closable=false 禁用点击遮罩关闭。适用于需要强制用户在抽屉内操作的场景。</p>
                <div class="sheet-row">
                    <Sheet title="不可调整大小" resizable="false">
                        <div class="sheet-tip">resizable=false：宽度固定，无法拖拽调整</div>
                    </Sheet>
                    <Sheet title="无遮罩" overlay="false">
                        <div class="sheet-tip">overlay=false：无背景遮罩，可点击外部元素</div>
                    </Sheet>
                    <Sheet title="禁用遮罩关闭" overlay-closable="false">
                        <div class="sheet-tip">overlay-closable=false：点击遮罩不关闭抽屉</div>
                    </Sheet>
                </div>
            </div>

            <div class="demo-section">
                <h3>富内容 Rich Content</h3>
                <p>抽屉内容支持任意 GPUI 元素，包括表单、按钮、列表等。下方演示一个含标题、输入框和操作按钮的富内容抽屉。</p>
                <Sheet title="用户设置">
                    <div class="sheet-panel">
                        <h4>个人信息</h4>
                        <p class="hint">在此区域放置表单或操作按钮。</p>
                        <div class="sheet-row">
                            <Button label="保存" primary size="small" />
                            <Button label="取消" size="small" />
                        </div>
                    </div>
                </Sheet>
            </div>
        </template>

        <template slot="api">
            <h3>Sheet</h3>
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
            <p>另：sheet 与 Sheet 标签等价。</p>
        </template>
    </CaseDocPage>
</component>
