<component>
    <CaseDocPage
        title={t("case.once.title")}
        description="once 指令标记元素仅首次渲染时求值，后续渲染复用首次快照。适合展示静态内容或避免重复计算。counter 字段每次点击递增，但 once 区域显示的值保持首次渲染时的快照。"
        code-rml={rml_sample}
        code-rust={rust_sample}>
        <template slot="demo">
            <div class="demo-section">
                <h3>实时 vs 一次性</h3>
                <p>counter（实时）：{counter}</p>
                <div display="flex" flex-direction="row" gap="16px">
                    <Button label="counter + 1" on-click={on_increment} />
                </div>
                <div display="flex" flex-direction="column" gap="8px">
                    <div class="demo-section">
                <h3>实时区域（无 once）</h3>
                        <p>每次 render 重新求值：counter = {counter}</p>
                    </div>
                    <div class="demo-section">
                <h3>快照区域（once）</h3>
                        <p>首次渲染后冻结：counter = {once_counter}</p>
                    </div>
                </div>
            </div>
        </template>

        <template slot="api">
            <Table columns={api_columns} rows={api_rows} bordered="" stripe="" />
        </template>
    </CaseDocPage>
</component>
