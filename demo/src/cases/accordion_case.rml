<component>
    <div v_flex="" class="case-pane doc-pane">
        <h2>{t("case.accordion.title")}</h2>

        <Card title="组件说明">
            <p>Accordion 是 gpui-component 折叠面板的 RML 封装，标签为小写 accordion。子项用 item 标签，title 属性指定面板标题，open 属性控制初始展开。</p>
            <p>核心概念：默认单展开模式（同时只能展开一项）；multiple 属性允许多展开；bordered 属性显示边框；small/large 控制尺寸；item 的 icon 属性添加图标；on_toggle_click 事件回调展开状态。</p>
        </Card>

        <Card title="API">
            <div class="api-table">
                <div class="api-row api-header"><span class="api-prop-name">属性</span><span class="api-prop-type">类型</span><span>说明</span></div>
                <div class="api-row"><span class="api-prop-name">bordered</span><span class="api-prop-type">布尔标志</span><span>显示边框</span></div>
                <div class="api-row"><span class="api-prop-name">multiple</span><span class="api-prop-type">布尔标志</span><span>允许多项同时展开</span></div>
                <div class="api-row"><span class="api-prop-name">small/large</span><span class="api-prop-type">布尔标志</span><span>尺寸变体</span></div>
                <div class="api-row"><span class="api-prop-name">on_toggle_click</span><span class="api-prop-type">事件</span><span>展开状态变化回调</span></div>
                <div class="api-row"><span class="api-prop-name">item title</span><span class="api-prop-type">字符串</span><span>面板标题</span></div>
                <div class="api-row"><span class="api-prop-name">item open</span><span class="api-prop-type">布尔标志</span><span>初始展开</span></div>
                <div class="api-row"><span class="api-prop-name">item icon</span><span class="api-prop-type">图标名</span><span>标题图标</span></div>
                <div class="api-row"><span class="api-prop-name">item disabled</span><span class="api-prop-type">布尔</span><span>禁用面板</span></div>
            </div>
        </Card>

        <Card title="示例代码">
            <div class="code-block">{code_sample}</div>
        </Card>

        <Card title="演示效果">
            <p>{status_text}</p>

            <div class="demo-section">
                <h3>{t("case.accordion.basic")}</h3>
                <accordion bordered="">
                    <item title={t("case.accordion.section1")} open="">
                        <p>{t("case.accordion.content1")}</p>
                    </item>
                    <item title={t("case.accordion.section2")}>
                        <p>{t("case.accordion.content2")}</p>
                    </item>
                    <item title={t("case.accordion.section3")}>
                        <p>{t("case.accordion.content3")}</p>
                    </item>
                </accordion>
            </div>

            <div class="demo-section">
                <h3>{t("case.accordion.multiple")}</h3>
                <accordion multiple="" bordered="">
                    <item title={t("case.accordion.section1")} open="">
                        <p>{t("case.accordion.content1")}</p>
                    </item>
                    <item title={t("case.accordion.section2")} open="">
                        <p>{t("case.accordion.content2")}</p>
                    </item>
                </accordion>
            </div>

            <div class="demo-section">
                <h3>{t("case.accordion.sizes")}</h3>
                <accordion small="" bordered="" on_toggle_click={on_toggle}>
                    <item title={t("case.accordion.small")}>
                        <p>{t("case.accordion.content1")}</p>
                    </item>
                </accordion>
                <accordion large="" bordered="" on_toggle_click={on_toggle}>
                    <item title={t("case.accordion.large")}>
                        <p>{t("case.accordion.content1")}</p>
                    </item>
                </accordion>
            </div>

            <div class="demo-section">
                <h3>{t("case.accordion.with_icon")}</h3>
                <accordion bordered="" on_toggle_click={on_toggle}>
                    <item title={t("case.accordion.settings")} icon="Settings">
                        <p>{t("case.accordion.content1")}</p>
                    </item>
                    <item title={t("case.accordion.disabled")} icon="Bell" disabled="true">
                        <p>{t("case.accordion.content2")}</p>
                    </item>
                </accordion>
            </div>

            <div class="demo-section">
                <h3>{t("case.accordion.nested")}</h3>
                <accordion bordered="">
                    <item title={t("case.accordion.parent")}>
                        <accordion bordered="" multiple="">
                            <item title={t("case.accordion.child1")}>
                                <p>{t("case.accordion.content1")}</p>
                            </item>
                            <item title={t("case.accordion.child2")}>
                                <p>{t("case.accordion.content2")}</p>
                            </item>
                        </accordion>
                    </item>
                </accordion>
            </div>
        </Card>
    </div>
</component>
